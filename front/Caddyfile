# Serveur du bundle Angular.
#
# La syntaxe {$VARIABLE:défaut} est résolue par Caddy au CHARGEMENT de sa
# configuration, c'est-à-dire au démarrage du conteneur. C'est ce qui permet à
# une seule et même image de servir en local, en staging et en production : la
# valeur ne vient plus du build mais de l'environnement d'exécution.
#
# Le port reste paramétrable, mais il ne s'agit PAS d'un réglage de sécurité :
# le binaire Caddy porte la capability de fichier `cap_net_bind_service=ep`, et
# c'est elle — pas le numéro de port — qui impose de conserver NET_BIND_SERVICE
# dans le conteneur. Écouter sur un port haut ne changerait rien. Voir K8S.md §11.
:{$SITE_PORT:80} {
	encode gzip

	# Configuration d'exécution du front, fabriquée ici plutôt que copiée dans
	# le bundle : c'est le point qui supprime le `localhost:8080` compilé en dur
	# (VARIABILISATION.md §5). Lue par src/app/config.ts avant le démarrage de
	# l'application.
	#
	# Le défaut vise le back de la stack locale, pour que `docker compose up`
	# fonctionne sans aucune variable.
	handle /config.json {
		header Content-Type application/json
		respond `{"apiBaseUrl":"{$FRONT_API_BASE_URL:http://localhost:8080}"}`
	}

	# Deux blocs `handle` plutôt qu'un `try_files` global : les directives d'un
	# Caddyfile sont réordonnées selon un ordre standard où `try_files` passe
	# AVANT `handle`. Sans cette séparation, /config.json serait réécrit en
	# /index.html avant d'atteindre le bloc ci-dessus — vérifié, le fichier
	# renvoyait alors le HTML de l'application.
	handle {
		root * /app/front
		try_files {path} /index.html
		file_server
	}
}
