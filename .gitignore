.DS_Store

# Dépendances de l'outillage racine (husky, commitlint, lint-staged, prettier)
/node_modules/

# Caches et rapports produits par les outils qualité / sécurité
.gradle/
.sonar/
.scannerwork/
.trivycache/
trivy-*-report.json

# Rapports des tests de performance k6 (produits en local par run_k6.sh)
/reports/

# Caches Python (scripts d'automatisation)
__pycache__/
*.pyc

# Réglages locaux de la stack docker-compose (modèle versionné : .env.example)
.env
