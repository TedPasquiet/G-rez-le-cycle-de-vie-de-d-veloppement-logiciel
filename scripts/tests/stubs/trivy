#!/usr/bin/env bash
#
# Faux trivy, utilisé seulement par run_tests.sh.
#
# Sert à tester l'option --scan de build_and_push.sh : quand Trivy trouve une
# faille CRITICAL il sort en erreur, et le script doit alors annuler le push.
#
# Variable qui pilote son comportement :
#   FAKE_TRIVY_FAIL   Si "1" : trivy trouve une vulnérabilité et sort en 1.

[[ "${FAKE_TRIVY_FAIL:-0}" == "1" ]] && exit 1
exit 0
