#!/usr/bin/env bash
#
# Faux docker, utilisé seulement par run_tests.sh.
#
# Même principe que le faux kubectl : il note les commandes reçues et renvoie
# le code de sortie demandé, sans rien construire ni envoyer nulle part. Ça
# permet de tester build_and_push.sh de bout en bout dans la CI, où il n'y a
# pas forcément de démon Docker.
#
# Variables qui pilotent son comportement (mises par le test) :
#   FAKE_DOCKER_LOG        Fichier où sont écrites les commandes reçues.
#   FAKE_DOCKER_LOGIN_FAIL Si "1" : `docker login` échoue.
#   FAKE_DOCKER_BUILD_FAIL Si "1" : `docker build` échoue.
#   FAKE_DOCKER_PULL_FAIL  Si "1" : `docker pull` échoue (image absente du
#                          registry), ce qui est le cas nominal d'échec de
#                          promote_image.sh.
#
# `docker run` est le seul cas où il ne se contente pas de noter : trivy_scan.sh
# lance Trivy par `docker run <image trivy> image …` dans les jobs `package-*`.
# Le faux docker saute alors ses propres options et l'image, puis passe la main
# au faux trivy voisin — qui se pilote par ses variables FAKE_TRIVY_*.

args="$*"

if [[ -n "${FAKE_DOCKER_LOG:-}" ]]; then
  echo "docker $args" >>"$FAKE_DOCKER_LOG"
fi

case "${1:-}" in
  login)
    # On vide stdin : build_and_push.sh envoie le mot de passe par ce canal
    # (--password-stdin). On ne l'écrit évidemment nulle part.
    cat >/dev/null
    [[ "${FAKE_DOCKER_LOGIN_FAIL:-0}" == "1" ]] && exit 1
    ;;
  build)
    [[ "${FAKE_DOCKER_BUILD_FAIL:-0}" == "1" ]] && exit 1
    ;;
  pull)
    [[ "${FAKE_DOCKER_PULL_FAIL:-0}" == "1" ]] && exit 1
    ;;
  run)
    shift
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -v | --volume) shift 2 ;;
        -*) shift ;;
        *) break ;;
      esac
    done
    # $1 est l'image : ce qui suit est la commande passée au conteneur.
    shift
    exec "$(dirname "${BASH_SOURCE[0]}")/trivy" "$@"
    ;;
esac

exit 0
