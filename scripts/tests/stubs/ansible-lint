#!/usr/bin/env bash
#
# Faux ansible-lint, utilisé seulement par run_tests.sh.
#
# Même principe que les faux kubectl/docker : il note ce qu'on lui demande et
# renvoie le code de sortie voulu, sans analyser le moindre rôle. Ça permet de
# tester ansible_check.sh dans la CI (image python:3.12-slim, où Ansible n'est
# pas installé) et surtout de provoquer le cas « le linter trouve quelque
# chose », qu'on ne peut pas obtenir autrement tant que le dépôt est propre.
#
# Il note aussi le répertoire courant, sur le modèle du K6_BASE_URL du faux k6.
# Ce n'est pas un détail de confort : c'est la seule façon de vérifier
# qu'ansible_check.sh a bien fait son `cd` dans `ansible/` avant d'appeler le
# linter. Sans ce `cd`, ansible.cfg n'est pas lu et le contrôle passe à côté de
# tout — c'est exactement ce que le test doit interdire de régresser.
#
# Deux lignes sont écrites par appel :
#   ansible-lint <arguments>
#   PWD=<répertoire courant au moment de l'appel>
#
# Variables qui pilotent son comportement (mises par le test) :
#   FAKE_ANSIBLE_LINT_LOG   Fichier où sont écrits les appels reçus.
#   FAKE_ANSIBLE_LINT_FAIL  Si "1" : des violations sont trouvées (sortie en 2,
#                           le code que renvoie le vrai ansible-lint dans ce
#                           cas ; ansible_check.sh ne regarde que le fait qu'il
#                           soit non nul).

if [[ -n "${FAKE_ANSIBLE_LINT_LOG:-}" ]]; then
  echo "ansible-lint $*" >>"$FAKE_ANSIBLE_LINT_LOG"
  echo "PWD=$PWD" >>"$FAKE_ANSIBLE_LINT_LOG"
fi

[[ "${FAKE_ANSIBLE_LINT_FAIL:-0}" == "1" ]] && exit 2
exit 0
