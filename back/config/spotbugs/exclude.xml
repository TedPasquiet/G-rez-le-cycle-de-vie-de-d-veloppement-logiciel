<?xml version="1.0" encoding="UTF-8"?>
<!--
  Filtre d'exclusion SpotBugs.
  Documentation : https://spotbugs.readthedocs.io/en/stable/filter.html
-->
<FindBugsFilter>

    <!-- Les entités JPA exposent volontairement des collections/dates mutables :
         c'est le contrat de Hibernate, pas un défaut de conception. -->
    <Match>
        <Class name="~.*\.(Person|Organization)"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Classe de démarrage Spring Boot : le main() est généré par le framework. -->
    <Match>
        <Class name="~.*Application"/>
        <Bug pattern="DM_EXIT,SIC_INNER_SHOULD_BE_STATIC_ANON"/>
    </Match>

    <!-- Code généré (Lombok, MapStruct, compilateur) : non maîtrisé par l'équipe. -->
    <Match>
        <Source name="~.*generated.*"/>
    </Match>

</FindBugsFilter>
