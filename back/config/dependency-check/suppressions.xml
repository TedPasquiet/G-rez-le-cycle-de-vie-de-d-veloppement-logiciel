<!--
  Suppressions OWASP Dependency-Check.

  À n'utiliser que pour un faux positif AVÉRÉ ou un risque accepté et daté.
  Toute suppression doit porter une justification et une date de revue.
  Documentation : https://jeremylong.github.io/DependencyCheck/general/suppression.html

  Exemple :
  <suppress until="2026-12-31Z">
      <notes>Faux positif : le CVE vise le client, nous n'utilisons que le serveur.</notes>
      <packageUrl regex="true">^pkg:maven/org\.example/lib@.*$</packageUrl>
      <cve>CVE-2024-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
