# Réglages de la stack docker-compose locale.
#
#   cp .env.example .env
#
# Toutes ces variables ont déjà une valeur par défaut dans docker-compose.yml :
# ce fichier ne sert qu'à en changer sans modifier le compose. `.env` est ignoré
# par Git, il ne doit donc jamais contenir de secret destiné à être partagé.

# Noms des images construites localement
BACK_IMAGE=back-p6
FRONT_IMAGE=front-p6

# Ports publiés sur la machine hôte
BACK_PORT=8080
FRONT_PORT=4200

# Origines autorisées par la configuration CORS du back (séparées par des
# virgules). Doit correspondre à l'URL réelle du front.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# URL de l'API telle que le navigateur doit l'appeler. Injectée au DÉMARRAGE du
# conteneur front (et non à la construction de l'image) : la même image sert en
# local, en staging et en production. Par défaut, le back publié par ce compose.
# Attention, c'est une adresse vue depuis le navigateur : `http://back:8080`
# fonctionnerait entre conteneurs mais pas depuis le poste.
FRONT_API_BASE_URL=http://localhost:8080
