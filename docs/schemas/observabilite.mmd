%% Schéma — L'observabilité et le pilotage.
%% Source versionnée du bloc Mermaid de docs/schema-architecture.md §10.
%% Les applications écrivent en JSON sur la sortie standard et ne connaissent pas
%% la destination de leurs logs. Le back est en plus tracé : l'agent
%% OpenTelemetry envoie ses traces à APM Server (détail du flux dans
%% traces-apm.mmd). Les quatre indicateurs DORA se contredisent
%% utilement : c'est leur lecture conjointe qui décrit une chaîne saine, jamais
%% l'un d'eux isolément.
flowchart TB
    subgraph cluster["Cluster"]
        direction LR
        pods["Pods back et front<br/>logs JSON sur la sortie standard"] --> fb["Filebeat<br/>DaemonSet"]
        back["Pod back<br/>agent OpenTelemetry"] --> apm["APM Server"]
    end

    fb -->|"champs ECS"| es[("Elasticsearch")]
    apm -->|"traces, et la latence<br/>qu'il en déduit"| es
    gl["Pipeline GitLab<br/>collecteur DORA"] --> es
    es --> kib["Kibana — tableaux de bord<br/>et application APM"]
    kib --> lect["Erreurs applicatives, latences de l'API,<br/>indicateurs de livraison"]
