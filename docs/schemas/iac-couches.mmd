flowchart TB
    subgraph A["Ansible — les machines"]
        a1["Paquets, Docker, cluster,<br/>outillage du poste"]
    end
    subgraph T["Terraform — l'enveloppe de l'environnement"]
        t1["Namespace, ResourceQuota,<br/>LimitRange, NetworkPolicy"]
